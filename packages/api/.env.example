## Core
NODE_ENV=development # default: development
API_PORT=3000 # default: 3000
API_VERSION=v1 # default: v1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fastsaas_api # Optional for startup (degraded mode)

## Auth
AUTH_BYPASS_ENABLED=true # Dev/test only, default: false
AUTH_DEV_USER_ID=dev-user # Dev/test only, default: dev-user
AUTH_DEV_TENANT_ID=dev-tenant # Dev/test only, default: dev-tenant
ENTRA_TENANT_ID=your-entra-tenant-id # Required when AUTH_BYPASS_ENABLED=false
ENTRA_CLIENT_ID=your-entra-client-id # Required when AUTH_BYPASS_ENABLED=false
ENTRA_ISSUER=https://login.microsoftonline.com/your-entra-tenant-id/v2.0 # default: derived from ENTRA_TENANT_ID
ENTRA_AUDIENCE=your-entra-client-id,api://your-entra-client-id # default: derived from ENTRA_CLIENT_ID
ENTRA_JWKS_URI=https://login.microsoftonline.com/your-entra-tenant-id/discovery/v2.0/keys # default: derived from ENTRA_TENANT_ID
JWT_REQUIRED_SCOPE=api:read # default: api:read

## Marketplace
MARKETPLACE_BASE_URL=https://marketplaceapi.microsoft.com # default: https://marketplaceapi.microsoft.com
MARKETPLACE_API_VERSION=2018-08-31 # default: 2018-08-31
MARKETPLACE_CLIENT_SECRET=your-value-here # SECRET # Required
MARKETPLACE_WEBHOOK_SECRET=your-value-here # SECRET # Required
MARKETPLACE_WEBHOOK_TIMESTAMP_TOLERANCE_MS=300000 # default: 300000 (5 min)

## Metering
METERING_READ_SCOPE=metering:read # default: metering:read
METERING_WRITE_SCOPE=metering:write # default: metering:write
METERING_BATCH_SIZE=500 # default: 500
METERING_WORKER_INTERVAL_MS=15000 # default: 15000
METERING_CLAIM_LEASE_MS=300000 # default: 300000
METERING_RETRY_BASE_DELAY_MS=60000 # default: 60000
METERING_RETRY_MAX_DELAY_MS=900000 # default: 900000
METERING_RETRY_JITTER_RATIO=0.1 # default: 0.1
METERING_MAX_RETRIES=8 # default: 8
METERING_SUBMISSION_SLA_MS=14400000 # default: 14400000 (4h)
MARKETPLACE_METERING_ENDPOINT=https://your-metering-endpoint.example.com # Optional override
# Metering reuses MARKETPLACE_CLIENT_SECRET.

## Logging
LOG_LEVEL=info # default: info

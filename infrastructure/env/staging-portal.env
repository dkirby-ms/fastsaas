# Static values
APP_NAME=portal
PORT=3001
HEALTH_PATH=/health
NODE_ENV=production
USE_MOCK_API=false
# TEMPORARY: Enable auth debug page for publisher role diagnosis (remove after resolved)
AUTH_DEBUG=true

# Deployment outputs
API_BASE_URL={{API_BASE_URL}}

# Entra ID authentication (from GitHub Actions secrets)
ENTRA_TENANT_ID={{ENTRA_TENANT_ID}}
ENTRA_CLIENT_ID={{PORTAL_ENTRA_CLIENT_ID}}
ENTRA_CLIENT_SECRET=secretref:portal-entra-client-secret
ENTRA_API_CLIENT_ID={{API_ENTRA_CLIENT_ID}}
NEXTAUTH_SECRET=secretref:portal-nextauth-secret
NEXTAUTH_URL={{PORTAL_URL}}
AUTH_TRUST_HOST=true

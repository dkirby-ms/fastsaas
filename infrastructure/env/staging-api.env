# Static values
API_PORT=3000
NODE_ENV=production
AUTH_DEBUG=true

# GitHub Actions secrets
ENTRA_TENANT_ID=organizations
ENTRA_CLIENT_ID={{API_ENTRA_CLIENT_ID}}

# Marketplace app registration values
MARKETPLACE_CLIENT_ID={{MARKETPLACE_CLIENT_ID}}
MARKETPLACE_TENANT_ID={{MARKETPLACE_TENANT_ID}}

# Marketplace secrets (Container App secret refs)
MARKETPLACE_CLIENT_SECRET=secretref:marketplace-client-secret
MARKETPLACE_WEBHOOK_SECRET=secretref:marketplace-webhook-secret

# Static values
API_PORT=3000
NODE_ENV=production

# GitHub Actions secrets
ENTRA_TENANT_ID={{AZURE_TENANT_ID}}
ENTRA_CLIENT_ID={{AZURE_CLIENT_ID}}

# Marketplace secrets (Container App secret refs)
MARKETPLACE_AUTH_TOKEN=secretref:marketplace-auth-token
MARKETPLACE_WEBHOOK_SECRET=secretref:marketplace-webhook-secret
